{
  "name": "gushan-lueying",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "孤山掠影:自驾×徒步混合行程规划桌面应用(自用)",
  "main": "electron/main.js",
  "productName": "孤山掠影",
  "engines": {
    "node": ">=20"
  },
  "_dependencyPolicy": "electron / electron-builder 锁死精确版本(打包产物必须可复现);eslint 带 ^(纯工具链,跟随小版本即可)。改动前先读这条。",
  "scripts": {
    "app": "electron .",
    "test": "npm run lint && node --test test/*.test.mjs && npm run smoke:dom",
    "test:unit": "node --test test/*.test.mjs",
    "lint": "eslint electron lib src",
    "lint:fix": "eslint electron lib src --fix",
    "smoke:rail": "node scripts/smoke-12306.cjs",
    "smoke:region": "node scripts/smoke-region.mjs",
    "smoke:dom": "electron test/dom-smoke.cjs",
    "preview": "node test/make-preview.mjs && node scripts/preview-server.mjs",
    "dist": "electron-builder --win portable --config.electronDist=node_modules/electron/dist",
    "shortcut": "node scripts/make-shortcut.mjs",
    "smoke:serve": "electron test/serve-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5"
  },
  "build": {
    "appId": "com.gushan.lueying",
    "productName": "孤山掠影",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "electron/**",
      "lib/**",
      "src/**",
      "data/**",
      "!data/config.json",
      "!data/marks.json",
      "!data/stations.json",
      "!data/oilprice.json",
      "!data/trips/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Gushan-portable.${ext}"
    }
  }
}
